# --- App ---
APP_NAME=AI Disaster Prediction & Response System
ENV=development
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# --- Database ---
# Default: SQLite (zero-config, works out of the box)
DATABASE_URL=sqlite:///./disaster_platform.db
# To switch to PostgreSQL/PostGIS later:
# DATABASE_URL=postgresql://user:password@localhost:5432/disaster_platform

# --- External APIs ---
USGS_EARTHQUAKE_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
NASA_FIRMS_MAP_KEY=
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv

# --- LLM (Emergency Chatbot) ---
# Groq free-tier API - https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Refresh intervals (seconds) ---
EARTHQUAKE_REFRESH_INTERVAL=300
WEATHER_REFRESH_INTERVAL=600
